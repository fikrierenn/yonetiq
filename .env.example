# Kopyalayip .env olarak kaydet
# cp .env.example .env

# Uygulama ve sqlcli ayni baglanti stringini kullanabilir.
# SQL Server baglantisini buraya yazin.
YONET_CONN=Server=localhost\\SQLEXPRESS;Database=YonetDB;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;Encrypt=False;

# Bos birakilirsa scripts/sqlcli.ps1 otomatik olarak YONET_CONN degerini kullanir.
SQLCLI_CONN=

# AI (opsiyonel)
GEMINI_API_KEY=
AI__Gemini__Model=gemini-2.5-flash
AI__Gemini__Endpoint=https://generativelanguage.googleapis.com

