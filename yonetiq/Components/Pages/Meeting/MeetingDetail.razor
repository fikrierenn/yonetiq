@page "/toplanti/{Id:int}"
@using YonetIQ.Data.Models
@using YonetIQ.Data.Services
@using YonetIQ.Components.Shared.AI
@inject MeetingService MeetingSvc
@inject UserService UserSvc
@inject LookupService LookupSvc
@inject IToastService Toast
@inject NavigationManager Nav
@inject YonetIQ.Data.Services.AI.AiOrchestrationService AiOrchestration
@inject SessionService SessionSvc

<PageTitle>Toplantı Detayı - @(_meeting?.Title ?? "Yükleniyor")</PageTitle>

@if (_prepResponse is not null && _prepResponse.IsSuccess)
{
    <SkillResultCard Response="_prepResponse" UserId="@SessionSvc.ActiveUser.UserId" />
}

@if (_isLoading)
{
    <div class="yi-loading-bar" role="status" aria-label="Yükleniyor"></div>
}
else if (_meeting == null)
{
    <div class="alert alert-danger m-4">Toplantı bulunamadı. <a href="/toplantilar">Listeye dön.</a></div>
}
else
{
    <PageHero Section="Toplantı Yönetimi" Icon="bi-calendar-event" Title="@_meeting.Title" Subtitle="@(_meeting.MeetingDate.ToString("dd.MM.yyyy HH:mm") + " - " + _meeting.Location)">
        <Actions>
            <a class="yi-btn-outline" href="@($"/toplanti/duzenle/{_meeting.Id}")"><i class="bi bi-pencil"></i> Düzenle</a>
            <button class="yi-btn-primary" @onclick="ScrollToDecisions"><i class="bi bi-plus-circle"></i> Karar Ekle</button>
            <button class="btn btn-sm yi-btn-ai" @onclick="ToggleAiSidebar" title="AI Asistan"><i class="bi bi-stars"></i> AI</button>
        </Actions>
    </PageHero>

    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <div class="yi-card h-100">
                <div class="yi-card-header"><h2 class="yi-card-title">Toplantı Bilgileri</h2></div>
                <div class="yi-card-body">
                    <div class="mb-3">
                        <label class="yi-label">Gündem</label>
                        <div class="p-2 border rounded bg-light small" style="white-space: pre-wrap">@_meeting.Agenda</div>
                    </div>
                    <div class="mb-3">
                        <label class="yi-label">Katılımcılar</label>
                        <div class="p-2 border rounded bg-light small">@_meeting.Participants</div>
                    </div>
                    @if (!string.IsNullOrEmpty(_meeting.Notes))
                    {
                        <div class="mb-3">
                            <label class="yi-label">Notlar</label>
                            <div class="p-2 border rounded bg-light small">@_meeting.Notes</div>
                        </div>
                    }
                </div>
                <div class="yi-card-footer">
                    <YonetIQ.Components.Shared.AttachmentManager EntityType="Meeting" EntityId="@_meeting.Id" />
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="yi-card h-100" id="decisions-section">
                <div class="yi-card-header d-flex justify-content-between align-items-center">
                    <h2 class="yi-card-title">Alınan Kararlar (@_decisions.Count)</h2>
                </div>
                <div class="yi-card-body">
                    <DecisionForm Decision="_newDecision" Users="_users" Priorities="_priorities" OnSave="SaveDecisionAsync" OnCancel="CancelEdit" />
                    
                    <div class="mt-4 overflow-x-auto">
                        <DecisionList Decisions="_decisions" Priorities="_priorities" ExpandedId="_expandedDecisionId" 
                                      OnEdit="EditDecision" OnDelete="DeleteDecisionAsync" 
                                      OnConvertToTask="ConvertToTaskAsync" OnToggleExpand="ToggleExpand" />
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<AiSidebar @ref="_aiSidebar" Module="meeting" Parameters="@_aiParams" />

@code {
    private AiSidebar? _aiSidebar;
    private Dictionary<string, object> _aiParams => new() { ["meetingId"] = Id };
    private void ToggleAiSidebar() { _aiSidebar?.Toggle(); }

    [Parameter] public int Id { get; set; }
    private bool _isLoading = true;
    private Meeting? _meeting;
    private List<Decision> _decisions = [];
    private List<User> _users = [];
    private List<Lookup> _priorities = [];
    private Decision _newDecision = new();
    private int? _expandedDecisionId;
    private YonetIQ.Data.Models.AI.AiResponse? _prepResponse;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _meeting = (await MeetingSvc.GetByIdAsync(Id)).Data;
        _users = (await UserSvc.GetAllAsync()).Data ?? [];
        _priorities = await LookupSvc.ListByGroupAsync("TaskPriority");
        _newDecision.MeetingId = Id;
        _newDecision.PriorityLookupId = _priorities.FirstOrDefault(p => p.Value == "Normal")?.Id;
        await LoadDecisionsAsync();
        _isLoading = false;

        // WP13: Toplantı 4 saat içindeyse otomatik hazırlık
        if (_meeting is not null && SessionSvc.IsLoggedIn)
        {
            var hoursUntil = (_meeting.MeetingDate - DateTime.UtcNow).TotalHours;
            if (hoursUntil is > 0 and <= 4)
            {
                _ = Task.Run(async () =>
                {
                    var req = new YonetIQ.Data.Models.AI.AiRequest
                    {
                        SkillId = "meeting.preparation",
                        UserId = SessionSvc.ActiveUser.UserId,
                        Module = "meeting",
                        Parameters = new() { ["entityId"] = Id }
                    };
                    _prepResponse = await AiOrchestration.ProcessRequestAsync(req);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
    }

    private async Task LoadDecisionsAsync() => _decisions = (await MeetingSvc.ListDecisionsAsync(Id)).Data ?? [];

    private void EditDecision(Decision d) 
    { 
        _newDecision = new Decision 
        { 
            Id = d.Id, 
            MeetingId = d.MeetingId, 
            Content = d.Content, 
            AssigneeId = d.AssigneeId, 
            AssigneeName = d.AssigneeName, 
            DueDate = d.DueDate, 
            PriorityLookupId = d.PriorityLookupId 
        }; 
    }

    private void CancelEdit() 
    { 
        _newDecision = new Decision 
        { 
            MeetingId = Id, 
            PriorityLookupId = _priorities.FirstOrDefault(p => p.Value == "Normal")?.Id 
        }; 
    }

    private async Task SaveDecisionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDecision.Content)) return;
        var res = await MeetingSvc.SaveDecisionAsync(_newDecision);
        if (res.IsSuccess) { Toast.ShowSuccess("Karar kaydedildi."); CancelEdit(); await LoadDecisionsAsync(); }
        else { Toast.ShowError(res.Message); }
    }

    private async Task DeleteDecisionAsync(int decisionId)
    {
        var res = await MeetingSvc.DeleteDecisionAsync(decisionId);
        if (res.IsSuccess) { Toast.ShowSuccess("Karar silindi."); await LoadDecisionsAsync(); }
        else { Toast.ShowError(res.Message); }
    }

    private async Task ConvertToTaskAsync(int decisionId)
    {
        var res = await MeetingSvc.ConvertDecisionToTaskAsync(decisionId);
        if (res.IsSuccess) { Toast.ShowSuccess($"Görev oluşturuldu (# {res.Data})"); await LoadDecisionsAsync(); }
        else { Toast.ShowError(res.Message); }
    }

    private void ToggleExpand(int id) => _expandedDecisionId = (_expandedDecisionId == id) ? null : id;
    private void ScrollToDecisions() => Nav.NavigateTo(Nav.Uri.Split('#', StringSplitOptions.None)[0] + "#decisions-section");
}
