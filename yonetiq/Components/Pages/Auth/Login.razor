@code {
    private LoginModel _model = new();
    private string?    _error;
    private bool       _loading;
    private bool       _showPassword;

    protected override void OnInitialized()
    {
        // Eğer kullanıcı zaten giriş yapmışsa, doğrudan ana sayfaya yönlendirilir.
        if (SessionService.IsLoggedIn)
            Nav.NavigateTo("/");
    }

    /// <summary>
    /// Giriş butonuna basıldığında tetiklenen ana metot.
    /// </summary>
    private async Task HandleLogin()
    {
        _error       = null;
        _loading = true;

        // AuthService üzerinden e-posta ve şifre doğrulaması yapılır.
        var result = await AuthService.LoginAsync(_model.Email!, _model.Password!);

        if (result.IsSuccess && result.Data is not null)
        {
            // Başarılı girişte SessionService güncellenir ve ana sayfaya gidilir.
            SessionService.Login(result.Data);
            Nav.NavigateTo("/");
        }
        else
        {
            // Giriş başarısızsa hata mesajı gösterilir.
            _error = result.Message ?? "Giriş yapılamadı. Lütfen e-posta ve şifrenizi kontrol edin.";
            _loading = false;
        }
    }

    /// <summary>
    /// Form verilerini tutmak için kullanılan yardımcı sınıf.
    /// </summary>
    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-posta zorunludur.")]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre zorunludur.")]
        public string? Password  { get; set; }
    }

#if DEBUG
    // ── DEMO (sadece DEBUG build'de derlenir) ──────────────────────────────────
    private record DemoAccount(string Icon, string Name, string Role, string Email);

    private readonly DemoAccount[] _demoAccounts =
