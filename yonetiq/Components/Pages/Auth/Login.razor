@page "/giris"
@layout LoginLayout
@inject AuthService AuthService
@inject SessionService SessionService
@inject NavigationManager Nav

<!--
    Kullanıcı Giriş Sayfası (Login).
    Sisteme erişim yetkisi almak için e-posta ve şifre doğrulaması yapar.
    Başarılı girişte kullanıcıyı ana sayfaya yönlendirir.
-->

<div class="yi-login-header">
    <div class="logo-mark">
        <img src="/brand/yonetiq-mark.svg" alt="YonetIQ" />
    </div>
    <h1><span style="color:var(--yi-primary)">Yonet</span><span style="color:var(--yi-accent)">IQ</span></h1>
    <p>Kurumsal Yönetim Portali</p>
    <div class="yi-login-client-brand mt-2">
        <img src="/brand/bkmkitap-logo.png" alt="bkmkitap" class="yi-login-client-logo" />
    </div>
</div>

<EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="login-form">
    <DataAnnotationsValidator />

    <div class="yi-form-group">
        <label class="yi-label" for="email">E-posta</label>
        <InputText id="email"
                   class="yi-input"
                   @bind-Value="_model.Email"
                   placeholder="ornek@yonetiq.local"
                   autocomplete="username"
                   inputmode="email" />
        <ValidationMessage For="() => _model.Email" class="yi-form-error" />
    </div>

    <div class="yi-form-group">
        <label class="yi-label" for="password">Şifre</label>
        <div class="yi-input-password-wrap">
            <InputText id="password"
                       type="@(_showPassword ? "text" : "password")"
                       class="yi-input"
                       @bind-Value="_model.Password"
                       placeholder="••••••••"
                       autocomplete="current-password" />
            <button type="button"
                    class="yi-password-toggle"
                    @onclick="() => _showPassword = !_showPassword"
                    title="@(_showPassword ? "Şifreyi gizle" : "Şifreyi göster")">
                <i class="bi bi-@(_showPassword ? "eye-slash" : "eye")"></i>
            </button>
        </div>
        <ValidationMessage For="() => _model.Password" class="yi-form-error" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="yi-alert yi-alert-warning mb-3" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@_error
        </div>
    }

    <button type="submit" class="yi-btn-primary yi-login-submit" disabled="@_loading">
        @if (_loading)
        {
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
            <span>Giriş yapılıyor…</span>
        }
        else
        {
            <i class="bi bi-box-arrow-in-right me-2"></i>
            <span>Giriş Yap</span>
        }
    </button>
    <div class="text-center mt-2">
        <a href="/sifremi-unuttum" class="yi-link" style="font-size:0.85rem">Şifremi Unuttum</a>
    </div>
</EditForm>

@* ── DEMO HIZLI GİRİŞ — sadece DEBUG modunda görünür ── *@
