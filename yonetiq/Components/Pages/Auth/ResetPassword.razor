@page "/sifre-sifirla"
@layout LoginLayout
@inject AuthService AuthSvc
@inject NavigationManager Nav

<!--
    Şifre Sıfırlama Sayfası.
    URL'deki token ile doğrulama yapılır, yeni şifre girilir.
-->

<div class="yi-login-header">
    <div class="logo-mark">
        <img src="/brand/yonetiq-mark.svg" alt="YonetIQ" />
    </div>
    <h1><span style="color:var(--yi-primary)">Yonet</span><span style="color:var(--yi-accent)">IQ</span></h1>
    <p>Yeni Şifre Oluştur</p>
</div>

@if (string.IsNullOrWhiteSpace(Token))
{
    <div class="yi-alert yi-alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Geçersiz bağlantı. Lütfen e-postanızdaki bağlantıya tekrar tıklayın.
    </div>
}
else if (_done)
{
    <div class="yi-alert yi-alert-success mb-3" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        Şifreniz başarıyla güncellendi!
    </div>
    <div class="text-center mt-3">
        <a href="/giris" class="yi-btn-primary" style="display:inline-flex;align-items:center;gap:0.5rem">
            <i class="bi bi-box-arrow-in-right"></i> Giriş Yap
        </a>
    </div>
}
else
{
    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="reset-password-form">
        <DataAnnotationsValidator />

        <div class="yi-form-group">
            <label class="yi-label" for="newpwd">Yeni Şifre</label>
            <div class="yi-input-password-wrap">
                <InputText id="newpwd"
                           type="@(_showPassword ? "text" : "password")"
                           class="yi-input"
                           @bind-Value="_model.Password"
                           placeholder="En az 8 karakter"
                           autocomplete="new-password" />
                <button type="button" class="yi-password-toggle"
                        @onclick="() => _showPassword = !_showPassword">
                    <i class="bi bi-@(_showPassword ? "eye-slash" : "eye")"></i>
                </button>
            </div>
            <ValidationMessage For="() => _model.Password" class="yi-form-error" />
        </div>

        <div class="yi-form-group">
            <label class="yi-label" for="confirmpwd">Şifre Tekrar</label>
            <InputText id="confirmpwd"
                       type="password"
                       class="yi-input"
                       @bind-Value="_model.ConfirmPassword"
                       placeholder="••••••••"
                       autocomplete="new-password" />
            <ValidationMessage For="() => _model.ConfirmPassword" class="yi-form-error" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="yi-alert yi-alert-warning mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@_error
            </div>
        }

        <button type="submit" class="yi-btn-primary yi-login-submit" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Kaydediliyor…</span>
            }
            else
            {
                <i class="bi bi-key me-2"></i>
                <span>Şifremi Güncelle</span>
            }
        </button>
    </EditForm>

    <div class="text-center mt-3">
        <a href="/sifremi-unuttum" class="yi-link small">Yeni sıfırlama bağlantısı iste</a>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private ResetModel _model        = new();
    private string?    _error;
    private bool       _loading      = false;
    private bool       _done         = false;
    private bool       _showPassword = false;

    private async Task HandleSubmitAsync()
    {
        _error = null;

        if (_model.Password != _model.ConfirmPassword)
        {
            _error = "Şifreler eşleşmiyor.";
            return;
        }

        _loading = true;
        var result = await AuthSvc.ResetPasswordAsync(Token!, _model.Password!);

        if (result.IsSuccess)
            _done = true;
        else
            _error = result.Message ?? "Şifre güncellenirken hata oluştu.";

        _loading = false;
    }

    private sealed class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Yeni şifre zorunludur.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "Şifre en az 8 karakter olmalıdır.")]
        public string? Password { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre tekrar zorunludur.")]
        public string? ConfirmPassword { get; set; }
    }
}
