@page "/sifremi-unuttum"
@layout LoginLayout
@inject AuthService AuthSvc
@inject EmailService EmailSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<!--
    Şifre Sıfırlama Başlatma Sayfası.
    E-posta adresi girilir, reset bağlantısı mail gönderilir.
    Güvenlik için kullanıcı yoksa da başarı mesajı gösterilir.
-->

<div class="yi-login-header">
    <div class="logo-mark">
        <img src="/brand/yonetiq-mark.svg" alt="YonetIQ" />
    </div>
    <h1><span style="color:var(--yi-primary)">Yonet</span><span style="color:var(--yi-accent)">IQ</span></h1>
    <p>Şifre Sıfırlama</p>
</div>

@if (_sent)
{
    <div class="yi-alert yi-alert-success mb-3" role="alert">
        <i class="bi bi-envelope-check me-2"></i>
        <strong>Kontrol edin!</strong> Kayıtlı e-posta adresinize sıfırlama bağlantısı gönderildi.
        Gelmezse spam klasörünüzü kontrol edin.
    </div>
    <div class="text-center mt-3">
        <a href="/giris" class="yi-link">Giriş sayfasına dön</a>
    </div>
}
else
{
    <p class="text-center" style="color:var(--yi-muted-color);font-size:0.9rem;margin-bottom:1.5rem">
        Kayıtlı e-posta adresinizi girin. Şifre sıfırlama bağlantısı gönderilecektir.
    </p>

    <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="forgot-password-form">
        <DataAnnotationsValidator />

        <div class="yi-form-group">
            <label class="yi-label" for="email">E-posta</label>
            <InputText id="email"
                       class="yi-input"
                       @bind-Value="_model.Email"
                       placeholder="ornek@sirket.com"
                       inputmode="email"
                       autocomplete="email" />
            <ValidationMessage For="() => _model.Email" class="yi-form-error" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="yi-alert yi-alert-warning mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@_error
            </div>
        }

        <button type="submit" class="yi-btn-primary yi-login-submit" disabled="@_loading">
            @if (_loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Gönderiliyor…</span>
            }
            else
            {
                <i class="bi bi-envelope me-2"></i>
                <span>Sıfırlama Bağlantısı Gönder</span>
            }
        </button>
    </EditForm>

    <div class="text-center mt-3">
        <a href="/giris" class="yi-link small">Giriş sayfasına dön</a>
    </div>
}

@code {
    private ForgotPasswordModel _model   = new();
    private string?             _error;
    private bool                _loading = false;
    private bool                _sent    = false;

    private async Task HandleSubmitAsync()
    {
        _error   = null;
        _loading = true;

        // Uygulama base URL'ini NavigationManager'dan al
        var baseUrl = Nav.BaseUri.TrimEnd('/');

        var result = await AuthSvc.InitiatePasswordResetAsync(_model.Email!, EmailSvc, baseUrl);

        if (result.IsSuccess)
            _sent = true;
        else
            _error = result.Message ?? "İşlem sırasında hata oluştu.";

        _loading = false;
    }

    private sealed class ForgotPasswordModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "E-posta zorunludur.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Geçerli bir e-posta giriniz.")]
        public string? Email { get; set; }
    }
}
