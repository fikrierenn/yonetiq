@using YonetIQ.Data.Models
@using YonetIQ.Data.Services

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="yi-card h-100">
            <div class="yi-card-header d-flex justify-content-between align-items-center">
                <h2 class="yi-card-title">Yaklaşan Görevler</h2>
                <a class="yi-link small" href="/gorevler">Tümünü gör</a>
            </div>
            <div class="yi-card-body p-0">
                @if (Tasks == null || Tasks.Count == 0)
                {
                    <div class="p-3 yi-empty m-3">Kayıt bulunamadı.</div>
                }
                else
                {
                    <table class="yi-table mb-0">
                        <thead>
                            <tr>
                                <th>Başlık</th>
                                <th>Atanan</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in Tasks)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        <a href="/gorev/@task.Id" class="text-decoration-none text-dark">@task.Title</a>
                                    </td>
                                    <td>@task.AssigneeName</td>
                                    <td><span class="yi-badge @GetStatusBadgeClass(task.StatusLookupId.ToString())">@GetLookupValue(task.StatusLookupId, TaskStatuses)</span></td>
                                    <td class="small">@task.DueDate?.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="yi-card h-100">
            <div class="yi-card-header d-flex justify-content-between align-items-center">
                <h2 class="yi-card-title">Son Kararlar</h2>
                <a class="yi-link small" href="/toplantilar">Tümünü gör</a>
            </div>
            <div class="yi-card-body p-0">
                @if (Decisions == null || Decisions.Count == 0)
                {
                    <div class="p-3 yi-empty m-3">Kayıt bulunamadı.</div>
                }
                else
                {
                    <table class="yi-table mb-0">
                        <thead>
                            <tr>
                                <th>Karar</th>
                                <th>Toplantı</th>
                                <th>Durum</th>
                                <th>Bitiş</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var decision in Decisions)
                            {
                                <tr>
                                    <td class="fw-semibold small">@decision.Content</td>
                                    <td class="small">
                                        <a href="/toplanti/@decision.MeetingId#decision-@decision.Id" class="yi-link">@decision.MeetingTitle</a>
                                    </td>
                                    <td><span class="yi-badge @GetStatusBadgeClass(decision.StatusLookupId.ToString())">@GetLookupValue(decision.StatusLookupId, DecisionStatuses)</span></td>
                                    <td class="small">@decision.DueDate?.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<TaskItem> Tasks { get; set; } = [];
    [Parameter] public List<Decision> Decisions { get; set; } = [];
    [Parameter] public List<Lookup> TaskStatuses { get; set; } = [];
    [Parameter] public List<Lookup> DecisionStatuses { get; set; } = [];

    private static string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Tamamlandi" or "10" => "yi-badge-success",
            "Devam" or "9" => "yi-badge-primary",
            "Bekliyor" or "8" => "yi-badge-secondary",
            _ => "yi-badge-secondary"
        };
    }

    private string GetLookupValue(int id, List<Lookup> lookups)
    {
        return lookups.FirstOrDefault(x => x.Id == id)?.Value ?? id.ToString();
    }
}
